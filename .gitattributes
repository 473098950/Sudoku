# 统一换行符：源码/脚本锁 LF，避免在 WSL / Linux 上出现 $'\r' 报错
* text=auto

*.sh    text eol=lf
*.py    text eol=lf
*.java  text eol=lf
*.pro   text eol=lf
*.pri   text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.qrc   text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# PowerShell 脚本保持 CRLF（Windows 友好）
*.ps1   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.ico   binary
*.jks   binary
*.apk   binary
*.exe   binary
